<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MioKit.LockBreaker.Preview.Views.MainWindow"
        x:CompileBindings="True"
        Title="MioKit.LockBreaker 预览"
        Width="960" Height="720" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShadBackgroundBrush}">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="20">
        <StackPanel Spacing="6">
            <TextBlock Text="占用查询 · 界面预览" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="使用固定样例展示真实插件控件。查询与结束按钮只执行预览操作。"
                       Classes="Muted" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <ComboBox x:Name="ScenarioPicker" SelectionChanged="OnScenarioChanged"
                      HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Classes="Outline" Content="打开文件窗口" Click="OnOpenFileWindow" />
            <Button Grid.Column="2" Classes="Outline" Content="打开端口窗口" Click="OnOpenPortWindow" />
        </Grid>
        <ContentControl Grid.Row="2" x:Name="PluginPreviewHost"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
