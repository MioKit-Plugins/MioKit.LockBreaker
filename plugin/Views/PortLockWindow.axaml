<shad:ShadWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shad="https://github.com/tiny-isle/Ti.Avalonia.Shadcn"
    xmlns:mio="https://github.com/tiny-isle/MioKit"
    xmlns:views="clr-namespace:MioKit.LockBreaker.Views"
    x:Class="MioKit.LockBreaker.Views.PortLockWindow"
    x:DataType="views:PortLockWindowModel" x:CompileBindings="True"
    CanPin="True" Width="880" Height="620" MinWidth="640" MinHeight="420"
    WindowStartupLocation="CenterScreen" Title="{Binding WindowTitle}"
    Background="{DynamicResource ShadBackgroundBrush}" Foreground="{DynamicResource ShadForegroundBrush}">
    <Interaction.Behaviors>
        <mio:PluginWindowBehavior Type="miokit.lock-finder" />
    </Interaction.Behaviors>
    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,160,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="端口" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Classes="Sm" PlaceholderText="例如 8080" Text="{Binding PortText, Mode=TwoWay}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding RefreshCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Grid Grid.Column="3">
                <Button Classes="Outline Sm" Content="查询" Foreground="{DynamicResource ShadForegroundBrush}"
                        BorderBrush="{DynamicResource ShadPrimaryBrush}" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsLoading}" />
                <Button Classes="Outline Sm" Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsLoading}" />
            </Grid>
            <Button Grid.Column="4" Classes="Ghost Sm" Content="更多">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="结束全部可管理进程" Classes="Destructive"
                                  Foreground="{DynamicResource ShadForegroundBrush}" Command="{Binding KillAllCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <views:ProcessListUserControl Grid.Row="1" />
    </Grid>
</shad:ShadWindow>
