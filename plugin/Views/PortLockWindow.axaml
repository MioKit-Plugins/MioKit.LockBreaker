<shad:ShadWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shad="https://github.com/tiny-isle/Ti.Avalonia.Shadcn"

    xmlns:mio="https://github.com/tiny-isle/MioKit"
    xmlns:views="clr-namespace:MioKit.LockBreaker.Views"
    mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
    CanPin="True"
    Width="760" Height="520"
    MinWidth="520" MinHeight="360"
    x:Class="MioKit.LockBreaker.Views.PortLockWindow"
    WindowStartupLocation="CenterScreen"
    x:DataType="views:PortLockWindowModel"
    Title="{Binding WindowTitle}"
    Background="{DynamicResource ShadBackgroundBrush}">

    <Interaction.Behaviors>
        <mio:PluginWindowBehavior Type="miokit.lock-finder" />
    </Interaction.Behaviors>

    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
            <Border Padding="14"
                    CornerRadius="{DynamicResource ShadCornerRadius}"
                    Background="{DynamicResource ShadCardBrush}"
                    BorderBrush="{DynamicResource ShadBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource ShadShadowSm}">
                <StackPanel Spacing="10">
                    <TextBlock Text="查询端口"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource ShadMutedForegroundBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 PlaceholderText="端口号，例如 8080"
                                 Text="{Binding PortText}" />
                        <Button Grid.Column="1"
                                Content="查询"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsLoading}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ShadMutedForegroundBrush}" />
                <ProgressBar Grid.Column="1"
                             Height="4"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Classes="Outline"
                            Content="结束选中"
                            Command="{Binding KillSelectedCommand}" />
                    <Button Classes="Destructive"
                            Content="全部结束"
                            Command="{Binding KillAllCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <views:ProcessListUserControl />
    </DockPanel>
</shad:ShadWindow>