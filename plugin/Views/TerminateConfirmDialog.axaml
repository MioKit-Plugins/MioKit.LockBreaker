<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MioKit.LockBreaker.Views"
             x:Class="MioKit.LockBreaker.Views.TerminateConfirmDialog"
             x:DataType="views:TerminateConfirmViewModel"
             x:CompileBindings="True"
             MinWidth="320"
             MaxWidth="420">
    <StackPanel Spacing="12">
        <TextBlock Classes="Muted"
                   Text="{Binding Description}"
                   TextWrapping="Wrap"
                   LineHeight="20" />

        <Border Background="{DynamicResource ShadMutedBrush}"
                BorderBrush="{DynamicResource ShadBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                IsVisible="{Binding HasProcesses}">
            <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TerminateConfirmProcessItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding DisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Classes="Small Muted"
                                       Text="{Binding PidText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Classes="Small Muted"
                   Text="未保存的数据可能会丢失，此操作无法撤销。"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
