<shad:ShadWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shad="https://github.com/tiny-isle/Ti.Avalonia.Shadcn"
    xmlns:mio="https://github.com/tiny-isle/MioKit"
    xmlns:views="clr-namespace:MioKit.LockBreaker.Views"
    x:Class="MioKit.LockBreaker.Views.ExplorerLockWindow" x:Name="FileWindow"
    x:DataType="views:ExplorerLockWindowModel" x:CompileBindings="True"
    CanPin="True" Width="880" Height="620" MinWidth="640" MinHeight="420"
    WindowStartupLocation="CenterScreen" Title="{Binding WindowTitle}"
    Background="{DynamicResource ShadBackgroundBrush}" Foreground="{DynamicResource ShadForegroundBrush}">
    <Interaction.Behaviors>
        <mio:PluginWindowBehavior Type="miokit.lock-finder" />
    </Interaction.Behaviors>
    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding TargetSummary}" VerticalAlignment="Center" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="Outline Sm" Content="管理目标">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="500" Spacing="10">
                            <TextBlock Text="查询目标" FontWeight="SemiBold" />
                            <TextBlock Text="文件夹查询包含其内部项目，可添加多个文件与文件夹。"
                                       FontSize="12" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox PlaceholderText="输入路径，按 Enter 添加" Text="{Binding PathInput, Mode=TwoWay}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddPathCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Classes="Outline Sm" Content="添加" Command="{Binding AddPathCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="Outline Sm" Content="选择文件" Click="OnPickFileClick" />
                                <Button Classes="Outline Sm" Content="选择文件夹" Click="OnPickFolderClick" />
                            </StackPanel>
                            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding TargetPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3">
                                                <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="Ghost Sm" Content="移除"
                                                        Command="{Binding #FileWindow.((views:ExplorerLockWindowModel)DataContext).RemoveTargetCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Grid Grid.Column="2">
                <Button Classes="Outline Sm" Content="查询" Foreground="{DynamicResource ShadForegroundBrush}"
                        BorderBrush="{DynamicResource ShadPrimaryBrush}" Command="{Binding RefreshCommand}" IsVisible="{Binding !IsLoading}" />
                <Button Classes="Outline Sm" Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsLoading}" />
            </Grid>
            <Button Grid.Column="3" Classes="Ghost Sm" Content="更多">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="结束全部可管理进程" Classes="Destructive"
                                  Foreground="{DynamicResource ShadForegroundBrush}" Command="{Binding KillAllCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <views:ProcessListUserControl Grid.Row="1" />
    </Grid>
</shad:ShadWindow>
